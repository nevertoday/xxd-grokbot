---
// 首页：先对新手说话（遇到过的事 → 交给 bot 以后的不同 → 三课入门 → 适不适合），
// 最后才是给用熟了的人的一张图和完整教程路线。文字现在是占位（「待写」/「TBD」）。
import Site from "../layouts/Site.astro";
import Contact from "../components/Contact.astro";
import { LESSONS, lessonHref, STEPS, stepHref, link, langOf, fullLang, t } from "../data/nav.js";
import { X as dict, fmt } from "../i18n/index.js";
import { inline } from "../lib/md.js";

const lang = langOf(Astro.url.pathname);
const ZH = {
  brand: "Grok Bot 新手教程",
  h1: "Grok Bot 新手教程",
  lead: ["这里用大白话讲 Grok Bot 怎么用，主线跟着 poteto 的文章《Automate Anything with Grok Bot》走。", "这是非官方学习站", "，内容还在写。"],
  cta: ["新手从这里开始", "用过了，看完整教程"],
  ctaNote: "新手入门一共三课。",
  painH: "你是不是遇到过这些",
  PAIN: ["待写：读者常遇到的事之一。", "待写：读者常遇到的事之二。", "待写：读者常遇到的事之三。"],
  diffH: "交给 bot 以后，有什么不一样",
  diffW: "什么时候", diffA: "自己做", diffB: "交给 bot",
  DIFF: [
    ["待写", "待写", "待写"],
    ["待写", "待写", "待写"],
    ["待写", "待写", "待写"],
  ],
  lessonsH: "新手只要三课", lessonsP: "按顺序看。学完这三课就会用了，网站上其他内容都是以后遇到了再查。",
  lessonsLabel: "新手入门：共 3 课",
  fitH: "适不适合你", yesH: "适合", noH: "先不用",
  YES: ["待写", "待写", "待写"],
  NO: ["待写", "待写", "待写"],
  devH: "用熟以后看这里",
  devP: "完整教程跟着 poteto 的文章走：先定目标，再讲做法，最后让 bot 自己按时开工。",
  FLOW: [
    ["Target", "定目标", "待写"],
    ["ListOrdered", "讲做法", "待写"],
    ["BookOpen", "存成技能", "待写"],
    ["CalendarClock", "按时开工", "待写"],
  ],
  CONN: ["待写", "待写", "待写"],
  stepsLabel: (n) => `完整教程：共 ${n} 步`,
};
const EN = {
  brand: "Grok Bot for beginners",
  h1: "Grok Bot for beginners",
  lead: ["How to use Grok Bot, in plain words. The main path follows poteto's article “Automate Anything with Grok Bot”. ", "This is an unofficial guide", ", and it's still being written."],
  cta: ["Start here if you're new", "Used it already? The full guide"],
  ctaNote: "The beginner track is three lessons.",
  painH: "Has this happened to you?",
  PAIN: ["TBD: a problem readers often hit (1).", "TBD: a problem readers often hit (2).", "TBD: a problem readers often hit (3)."],
  diffH: "What changes when a bot does it",
  diffW: "When", diffA: "Doing it yourself", diffB: "With a bot",
  DIFF: [
    ["TBD", "TBD", "TBD"],
    ["TBD", "TBD", "TBD"],
    ["TBD", "TBD", "TBD"],
  ],
  lessonsH: "Beginners need just three lessons", lessonsP: "Read them in order. After these three you can use it. Everything else on the site is for looking up later.",
  lessonsLabel: "Beginner track: 3 lessons",
  fitH: "Is it for you?", yesH: "Yes, if", noH: "Not yet, if",
  YES: ["TBD", "TBD", "TBD"],
  NO: ["TBD", "TBD", "TBD"],
  devH: "Once you're comfortable",
  devP: "The full guide follows poteto's article: start with the goal, explain your process, then let your bots start work on their own.",
  FLOW: [
    ["Target", "Set the goal", "TBD"],
    ["ListOrdered", "Explain the process", "TBD"],
    ["BookOpen", "Save it as a skill", "TBD"],
    ["CalendarClock", "Run it on a schedule", "TBD"],
  ],
  CONN: ["TBD", "TBD", "TBD"],
  stepsLabel: (n) => `Full guide: ${n} steps`,
};
// 以后加的语言：文字来自 src/i18n/<语言>.js；FLOW 的图标沿用英文版；完整教程链到英文版
const x = dict(lang);
const fl = fullLang(lang);
const C = x
  ? { ...EN, ...x.home, brand: x.ui.brand, FLOW: EN.FLOW.map(([icon], i) => [icon, ...(x.home.FLOW[i] ?? EN.FLOW[i].slice(1))]), stepsLabel: (n) => fmt(x.home.stepsLabel, { n }) }
  : lang === "en" ? EN : ZH;
const headings = [["h-pain", C.painH], ["h-diff", C.diffH], ["h-lessons", C.lessonsH], ["h-fit", C.fitH], ["h-dev", C.devH]].map(([slug, text]) => ({ slug, text, depth: 2 }));
---
<Site title={C.brand} headings={headings}>
  <div class="home">
    <h1>{C.h1}</h1>
    <p class="home__lead">{C.lead[0]}<mark>{C.lead[1]}</mark>{C.lead[2]}</p>
    <div class="home__cta">
      <a class="xxd-btn" data-variant="primary" href={lessonHref(LESSONS[0], lang)}>{C.cta[0]}<i data-xxd-icon="ArrowRight" data-size="16"></i></a>
      <a class="xxd-btn" data-variant="ghost" href={stepHref(STEPS[0], fl)} hreflang={fl === lang ? undefined : fl}>{C.cta[1]}</a>
    </div>
    <p class="home__note">{C.ctaNote}</p>

    <section aria-labelledby="h-pain">
      <h2 id="h-pain">{C.painH}</h2>
      <ul class="pain">{C.PAIN.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section aria-labelledby="h-diff">
      <h2 id="h-diff">{C.diffH}</h2>
      <div class="xxd-table-wrap diff">
        <table class="xxd-table">
          <thead><tr><th scope="col">{C.diffW}</th><th scope="col" data-wrap>{C.diffA}</th><th scope="col" data-wrap>{C.diffB}</th></tr></thead>
          <tbody>{C.DIFF.map(([w, a, b]) => <tr><th scope="row" class="diff__when">{w}</th><td data-wrap class="diff__before">{a}</td><td data-wrap>{b}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="h-lessons">
      <h2 id="h-lessons">{C.lessonsH}</h2>
      <p>{C.lessonsP}</p>
      <ol class="xxd-steps roadmap" data-vertical aria-label={C.lessonsLabel}>
        {LESSONS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={lessonHref(s, lang)}>{t(s, "title", lang)}</a>
              <span class="xxd-steps__desc">{t(s, "minutes", lang)} · {t(s, "sum", lang)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="h-fit">
      <h2 id="h-fit">{C.fitH}</h2>
      <div class="fit">
        <div class="route"><h3><i data-xxd-icon="CircleCheck" data-size="18"></i>{C.yesH}</h3><ul>{C.YES.map((x) => <li>{x}</li>)}</ul></div>
        <div class="route"><h3><i data-xxd-icon="CircleX" data-size="18"></i>{C.noH}</h3><ul>{C.NO.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <section aria-labelledby="h-dev">
      <h2 id="h-dev">{C.devH}</h2>
      <p>{C.devP}</p>
      {x && <p class="home__note">{C.devNote}</p>}
      <div class="flow">
        {C.FLOW.map(([icon, h, p], i) => (
          <>
            {i > 0 && (
              <div class="flow__conn" aria-hidden="true">
                <span class="flow__label">{C.CONN[i - 1]}</span>
                <span class="flow__track"><span class="flow__dot" style={`animation-delay:${(i - 1) * 1.2}s`}></span><i class="flow__head" data-xxd-icon="ChevronRight" data-size="14"></i></span>
              </div>
            )}
            <div class="flow__box" data-mine={i === 1 ? "" : undefined}>
              <i class="flow__icon" data-xxd-icon={icon} data-size="20"></i>
              <p class="flow__title">{h}</p>
              <p class="flow__desc">{p}</p>
            </div>
          </>
        ))}
      </div>
      <ol class="xxd-steps roadmap" data-vertical start={STEPS[0].n} aria-label={C.stepsLabel(STEPS.length)}>
        {STEPS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={stepHref(s, fl)}>{t(s, "title", fl)}</a>
              <span class="xxd-steps__desc">{t(s, "minutes", fl)} · {t(s, "sum", fl)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <Contact />
  </div>
</Site>
