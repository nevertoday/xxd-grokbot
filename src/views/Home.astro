---
// 首页：先对新手说话（遇到过的事 → 交给 bot 以后的不同 → 三课入门 → 适不适合），
// 最后才是给用熟了的人的一张图（文章的四个想法）和完整教程路线。
import Site from "../layouts/Site.astro";
import Contact from "../components/Contact.astro";
import { LESSONS, lessonHref, STEPS, stepHref, link, langOf, fullLang, t } from "../data/nav.js";
import { X as dict, fmt } from "../i18n/index.js";
import { inline } from "../lib/md.js";

const lang = langOf(Astro.url.pathname);
const ZH = {
  brand: "Grok Bot 新手教程",
  h1: "用好 Grok Bot，靠的是思路",
  lead: ["在 SpaceX 做 Grok Bot 的 poteto 说，自动化其实是一种思考方式，谁都学得会：先想清楚最后要什么结果，再把你平时怎么做讲给 bot 听，等它做对一次，就让它按时自己开工。不用会写代码。", "这是非官方学习站", "，跟着作者那篇《Automate Anything with Grok Bot》一步步讲，功能以官方文档为准。"],
  cta: ["新手从这里开始", "用过了，看完整教程"],
  ctaNote: "新手入门一共三课：先想清楚目标，再建一个 bot，最后把一件事交给它。",
  painH: "你是不是也遇到过这些",
  PAIN: [
    "每周都要花一个下午，把同样的几步再做一遍。",
    "想交给 AI，可聊天的 AI 只会回话，点、复制、发送还得你自己来。",
    "听说能自动化，一看要写代码，就放下了。",
  ],
  diffH: "交给 bot 以后，有什么不一样",
  diffW: "什么时候", diffA: "自己做", diffB: "交给 bot",
  DIFF: [
    ["开工", "你想起来才做", "到点自己开工"],
    ["做的时候", "你一步步点、复制、粘贴", "它用云上的电脑做"],
    ["你合上电脑", "活就停了", "它在云上接着做"],
  ],
  lessonsH: "新手只要三课", lessonsP: "按顺序看就行。学完这三课就能用起来，网站上别的内容，遇到了再查。",
  lessonsLabel: "新手入门：共 3 课",
  fitH: "适不适合你", yesH: "适合", noH: "先不用",
  YES: ["有一件在电脑上反复做的事，想交出去", "有 The X Subscription 的 Premium、Super 或 Ultra 套餐", "能用大白话讲出你平时怎么做"],
  NO: ["只有 Plus 套餐，它不包含 Grok Bot", "手边没有电脑，桌面版要先装在电脑上", "只想问个问题，平常的 AI 聊天就够了"],
  devH: "用熟以后看这里",
  devP: "完整教程跟着 poteto 的文章往深里讲。文章里挑出的四个想法，一句话一个：",
  FLOW: [
    ["Target", "先定目标", "想清楚最后要什么结果。填表、发邮件只是路上的一步。"],
    ["ListOrdered", "讲清做法", "一口气说出你平时怎么做，让它先复述，纠正几轮再开工。"],
    ["BookOpen", "教它怎么判断", "你不用想就会做的那些决定，拿真实的例子讲给它听。"],
    ["CalendarClock", "让它自己开工", "用 routine 定好什么时候做：到点就做，或者等一封邮件来了再做。"],
  ],
  CONN: ["说给它听", "拿例子试", "做对以后"],
  stepsLabel: (n) => `完整教程：共 ${n} 步`,
};
const EN = {
  brand: "Grok Bot for beginners",
  h1: "Getting the most out of Grok Bot starts with how you think",
  lead: ["Automation is really a way of thinking, and anyone can learn it, says poteto, who builds Grok Bot at SpaceX. Get clear on the result you want, tell the bot how you do the job now, and once it gets it right, let it start on its own, on time. You don't need to code. ", "This is an unofficial guide", " that follows the author's article “Automate Anything with Grok Bot” step by step. For features, the official docs are the source of truth."],
  cta: ["Start here if you're new", "Used it already? The full guide"],
  ctaNote: "The beginner track is three lessons: get clear on the goal, make a bot, then hand it one job.",
  painH: "Has this happened to you?",
  PAIN: [
    "Every week you lose an afternoon doing the same few steps again.",
    "You'd hand it to an AI, but a chat AI only answers. You still do the clicking, copying and sending.",
    "You heard about automation, saw it meant writing code, and gave up.",
  ],
  diffH: "What changes when a bot does it",
  diffW: "When", diffA: "Doing it yourself", diffB: "With a bot",
  DIFF: [
    ["Starting", "When you remember", "On time, by itself"],
    ["Doing the work", "You click, copy, paste", "It uses a computer in the cloud"],
    ["Laptop closed", "The work stops", "It keeps going in the cloud"],
  ],
  lessonsH: "Beginners need just three lessons", lessonsP: "Just read them in order. After these three you can put it to work, and everything else on the site is there to look up when you need it.",
  lessonsLabel: "Beginner track: 3 lessons",
  fitH: "Is it for you?", yesH: "Yes, if", noH: "Not yet, if",
  YES: ["You have a job you repeat on a computer and want to hand off", "You have Premium, Super or Ultra on The X Subscription", "You can explain in plain words how you do the job"],
  NO: ["You're on Plus, which doesn't include Grok Bot", "You don't have a computer, since you install the desktop app on one first", "You only want to ask a question, and a regular AI chat is enough for that"],
  devH: "Once you're comfortable",
  devP: "The full guide goes deeper, following poteto's article. Here are four of its ideas, one line each:",
  FLOW: [
    ["Target", "Start with the goal", "Know the result you want. Filling in a form or sending an email is only one step on the way."],
    ["ListOrdered", "Explain your process", "Say how you do it now, all in one go. It restates it first, and you correct it a few times before it starts."],
    ["BookOpen", "Teach it how you decide", "Walk it through real examples of the calls you make without thinking."],
    ["CalendarClock", "Let it start on its own", "A routine sets when it works: on a schedule, or when an email arrives."],
  ],
  CONN: ["tell it", "try examples", "once it's right"],
  stepsLabel: (n) => `Full guide: ${n} steps`,
};
// 以后加的语言：文字来自 src/i18n/<语言>.js；FLOW 的图标沿用英文版；完整教程链到英文版
const x = dict(lang);
const fl = fullLang(lang);
const C = x
  ? { ...EN, ...x.home, brand: x.ui.brand, FLOW: EN.FLOW.map(([icon], i) => [icon, ...(x.home.FLOW[i] ?? EN.FLOW[i].slice(1))]), stepsLabel: (n) => fmt(x.home.stepsLabel, { n }) }
  : lang === "en" ? EN : ZH;
const headings = [["h-pain", C.painH], ["h-diff", C.diffH], ["h-lessons", C.lessonsH], ["h-fit", C.fitH], ["h-dev", C.devH]].map(([slug, text]) => ({ slug, text, depth: 2 }));
---
<Site title={C.brand} headings={headings}>
  <div class="home">
    <h1>{C.h1}</h1>
    <p class="home__lead">{C.lead[0]}<mark>{C.lead[1]}</mark>{C.lead[2]}</p>
    <div class="home__cta">
      <a class="xxd-btn" data-variant="primary" href={lessonHref(LESSONS[0], lang)}>{C.cta[0]}<i data-xxd-icon="ArrowRight" data-size="16"></i></a>
      <a class="xxd-btn" data-variant="ghost" href={stepHref(STEPS[0], fl)} hreflang={fl === lang ? undefined : fl}>{C.cta[1]}</a>
    </div>
    <p class="home__note">{C.ctaNote}</p>

    <section aria-labelledby="h-pain">
      <h2 id="h-pain">{C.painH}</h2>
      <ul class="pain">{C.PAIN.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section aria-labelledby="h-diff">
      <h2 id="h-diff">{C.diffH}</h2>
      <div class="xxd-table-wrap diff">
        <table class="xxd-table">
          <thead><tr><th scope="col">{C.diffW}</th><th scope="col" data-wrap>{C.diffA}</th><th scope="col" data-wrap>{C.diffB}</th></tr></thead>
          <tbody>{C.DIFF.map(([w, a, b]) => <tr><th scope="row" class="diff__when">{w}</th><td data-wrap class="diff__before">{a}</td><td data-wrap>{b}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="h-lessons">
      <h2 id="h-lessons">{C.lessonsH}</h2>
      <p>{C.lessonsP}</p>
      <ol class="xxd-steps roadmap" data-vertical aria-label={C.lessonsLabel}>
        {LESSONS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={lessonHref(s, lang)}>{t(s, "title", lang)}</a>
              <span class="xxd-steps__desc">{t(s, "minutes", lang)} · {t(s, "sum", lang)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="h-fit">
      <h2 id="h-fit">{C.fitH}</h2>
      <div class="fit">
        <div class="route"><h3><i data-xxd-icon="CircleCheck" data-size="18"></i>{C.yesH}</h3><ul>{C.YES.map((x) => <li>{x}</li>)}</ul></div>
        <div class="route"><h3><i data-xxd-icon="CircleX" data-size="18"></i>{C.noH}</h3><ul>{C.NO.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <section aria-labelledby="h-dev">
      <h2 id="h-dev">{C.devH}</h2>
      <p>{C.devP}</p>
      {x && <p class="home__note">{C.devNote}</p>}
      <div class="flow">
        {C.FLOW.map(([icon, h, p], i) => (
          <>
            {i > 0 && (
              <div class="flow__conn" aria-hidden="true">
                <span class="flow__label">{C.CONN[i - 1]}</span>
                <span class="flow__track"><span class="flow__dot" style={`animation-delay:${(i - 1) * 1.2}s`}></span><i class="flow__head" data-xxd-icon="ChevronRight" data-size="14"></i></span>
              </div>
            )}
            <div class="flow__box" data-mine={i === 1 ? "" : undefined}>
              <i class="flow__icon" data-xxd-icon={icon} data-size="20"></i>
              <p class="flow__title">{h}</p>
              <p class="flow__desc">{p}</p>
            </div>
          </>
        ))}
      </div>
      <ol class="xxd-steps roadmap" data-vertical start={STEPS[0].n} aria-label={C.stepsLabel(STEPS.length)}>
        {STEPS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={stepHref(s, fl)}>{t(s, "title", fl)}</a>
              <span class="xxd-steps__desc">{t(s, "minutes", fl)} · {t(s, "sum", fl)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <Contact />
  </div>
</Site>
